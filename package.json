{
  "name": "openwebgis",
  "version": "1.0.0",
  "description": "Open WebGIS",
  "type": "module",
  "scripts": {
    "install": "npm install --prefix ./apps/api && npm install --prefix ./apps/web",
    "start": "node start.js full",
    "start:api": "node start.js api",
    "start:web": "node start.js web",
    "postinstall": "chmod +x start.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meadow1773/openwebgis.git"
  },
  "author": "Meadow1773",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/meadow1773/openwebgis/issues"
  },
  "homepage": "https://github.com/meadow1773/openwebgis#readme",
  "dependencies": {
    "axios": "^1.19.0",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}